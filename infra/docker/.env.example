# ==========================================
# Configurações do Banco de Dados PostgreSQL
# ==========================================
# Usuário root/admin do banco
POSTGRES_USER=bankuser
# Senha do banco (alterar em produção)
POSTGRES_PASSWORD=change_me_in_production
# Nome do banco de dados inicial
POSTGRES_DB=system_bank

# ==========================================
# Configurações do RabbitMQ (Mensageria)
# ==========================================
# Usuário de acesso ao painel e broker
RABBITMQ_USER=guest
# Senha de acesso (alterar em produção)
RABBITMQ_PASS=change_me_in_production

# ==========================================
# Configurações da API em Rust
# ==========================================
# Chave secreta para assinatura dos JWT (Mínimo 32 caracteres)
JWT_SECRET=change_me_in_production_min_32_chars
# Tempo de expiração do token em segundos (Padrão: 900 = 15min)
JWT_EXPIRY_SECS=900

# ==========================================
# Configurações do Grafana (Monitoramento)
# ==========================================
# Senha de admin inicial do Grafana
GRAFANA_PASSWORD=admin
