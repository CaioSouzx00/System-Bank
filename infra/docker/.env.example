# ==========================================
# Configurações do Banco de Dados PostgreSQL
# ==========================================
# Usuário root/admin do banco
POSTGRES_USER=bankuser
# Senha do banco (alterar em produção)
POSTGRES_PASSWORD=change_me_in_production
# Nome do banco de dados inicial
POSTGRES_DB=system_bank

# ==========================================
# Configurações do RabbitMQ (Mensageria)
# ==========================================
# Usuário de acesso ao painel e broker
RABBITMQ_USER=guest
# Senha de acesso (alterar em produção)
RABBITMQ_PASS=change_me_in_production

# ==========================================
# Autenticação & Segurança (JWT RS256 Asymmetric)
# ==========================================
# A API atua como Resource Server validando tokens emitidos por um IdP / Auth Server.
# Utiliza assinatura assimétrica RS256: apenas a chave pública RSA é necessária na API.
#
# Opção 1 (Recomendada p/ Docker/CI): Chave pública RSA PEM codificada em Base64 (chave dev inclusa)
JWT_PUBLIC_KEY_
#
# Opção 2: Chave pública RSA direta em formato PEM
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"


# ==========================================
# Configurações do Grafana (Monitoramento)
# ==========================================
# Senha de admin inicial do Grafana
GRAFANA_PASSWORD=admin
