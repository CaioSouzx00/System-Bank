{
  "title": "API Observability",
  "uid": "api-observability",
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests/s",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(rate({job=\"docker\"} | json | http_route!=\"\" [1m]))",
          "legendFormat": "Requests per second"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(rate({job=\"docker\"} | json | http_status_code >= 500 [1m])) / sum(rate({job=\"docker\"} | json | http_route!=\"\" [1m])) * 100",
          "legendFormat": "Error Rate (%)"
        }
      ]
    },
    {
      "type": "logs",
      "title": "API Logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"docker\"} |= \"system-bank-api\" | json"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "timezone": "browser"
}
